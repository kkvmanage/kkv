# Application Configuration
PORT=8080
APP_NAME=KKV Gold Finance & Rental Management
NODE_ENV=development

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB Atlas Live Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kkv_gold_finance
RENTAL_MONGODB_DB_NAME=kkv_rental

# Google Drive Synchronization & Disaster Recovery (Folder: kkv finance)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google-drive/callback
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_DRIVE_ACCOUNT_EMAIL=goldfinancekkv@gmail.com
GOOGLE_DRIVE_FOLDER_ID=1gqDbQuvf2EWkh_y-kiqRDBV3fOpEEGPx

# Service Account (Optional Fallback)
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Security
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
