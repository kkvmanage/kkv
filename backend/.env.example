# Application Configuration
PORT=8080
APP_NAME=KKV Gold Finance & Rental Management
NODE_ENV=development

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Primary Backend Database (Automatic Local Ledger Storage)
# Ledger directory: backend/KKV_GOLD_FINANCE/rental/

# Google Drive / Google Sheets Synchronization (Rental Mirror & Backup)
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
RENTAL_SPREADSHEET_ID=your-google-sheets-spreadsheet-id

# Security
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Optional OAuth / Notifications
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google-drive/callback
GOOGLE_REFRESH_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
