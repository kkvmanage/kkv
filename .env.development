# KKV Gold Finance - Frontend Environment Configuration
# To use the deployed Vercel Backend:
VITE_FINANCE_API_BASE_URL=https://kkv-smoky.vercel.app
VITE_API_BASE_URL=https://kkv-smoky.vercel.app/api

# If testing with a local backend on port 8080, uncomment below:
# VITE_FINANCE_API_BASE_URL=http://localhost:8080
# VITE_API_BASE_URL=http://localhost:8080/api

VITE_APP_NAME=KKV Gold Finance
VITE_APP_ENV=development
